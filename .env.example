# Copy to .env.local for local work; set the same names in Vercel for the live site.
# Vercel sets VERCEL_PROJECT_PRODUCTION_URL on its own (used for social cards).

# Email sign-ups go into the Shopify admin as subscribed customers.
# Leave these empty and every form still works, but nothing is kept.
# shopify/README.md explains how to get them (a Dev Dashboard app with the
# read_customers and write_customers scopes, installed on the store).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Only for an app made in the Shopify admin before 2026, which gives a token
# instead of a client ID and secret. Used in place of the two above when set.
SHOPIFY_ADMIN_TOKEN=

# Optional: send sign-ups to another store (a development store, for testing).
# Defaults to alassaltco.myshopify.com.
SHOPIFY_STORE_DOMAIN=
