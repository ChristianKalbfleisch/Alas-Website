# Copy to .env.local for local development. Set the same values in Vercel's
# project settings for deployments. .env.local is gitignored — never commit it.

# The store's permanent domain. Not the customer-facing domain.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=alassaltco.myshopify.com

# Storefront API version. Bump deliberately, not incidentally — a version
# change can alter query shapes.
NEXT_PUBLIC_SHOPIFY_API_VERSION=2025-07

# Public Storefront API access token, from Shopify admin → Sales channels →
# Headless → your storefront.
#
# This token is public by design. It is scoped to unauthenticated storefront
# reads and cart writes, it ships in the client bundle, and Shopify intends it
# to be visible. Keeping it in env means it can be rotated without a code
# change — that is the only reason it lives here rather than in source.
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# ---------------------------------------------------------------------------
# Server-only. Optional.
# ---------------------------------------------------------------------------
# A private Storefront API token raises rate limits and skips bot challenges
# for server-rendered requests. Only add one if rate limits become a problem.
#
# It must NEVER carry the NEXT_PUBLIC_ prefix and must never be pasted into
# chat, a commit, or client code. Set it in Vercel directly.
# SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# An Admin API token has write access to the whole store. It has no place in
# this repo or in any frontend. Listed here only so the rule is written down.
